{% extends "layout.njk" %}
{%- from "moj/components/alert/macro.njk" import mojAlert -%}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageHeaderTitle = "Booker details" %}

{% set noLinkedVisitorsHtml %}
  <p data-test="no-linked-visitors">
    There are no linked visitors.
  </p>
{% endset %}
{% set noVisitorRequestsHtml %}
  <p data-test="no-visitor-requests">
    There are no requests to link visitors.
  </p>
{% endset %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {# Messages #}
      {% for message in messages %}
        {{ mojAlert(message) }}
      {% endfor %}

      <h1 class="govuk-heading-l">{{ pageHeaderTitle }}</h1>

      {# Booker details #}
      <dl class="govuk-list bapv-booker-details">
        <dt>Email address:</dt>
        <dd data-test="booker-email">{{ booker.email }}</dd>

        <dt>Booker reference:</dt>
        <dd data-test="booker-reference">{{ booker.reference }}</dd>
      </dl>

      {% if booker.permittedPrisoners | length %}
        <p>
          Linking prisoners and visitors to an account lets the booker select them when booking visits online.<br>
          This page shows prisoners from all prisons.
        </p>

        {% set prisonerRowItems = [] %}
        {% set visitorRequestRowItems = [] %}

        {% for prisoner in booker.permittedPrisoners %}
          {# Prisoner #}
          {% set prisonerName = (prisoner.prisoner.lastName + ", " + prisoner.prisoner.firstName) | properCaseFullName | escape %}
          {% set prisonerNumber = prisoner.prisoner.prisonerNumber %}
          {% set prisonerIndex = "prisoner-" + loop.index %}

          {# Visitors #}
          {% if prisoner.permittedVisitors | length %}
            {%- for visitor in prisoner.permittedVisitors %}

              {% set visitorIndex = prisonerIndex + "-visitor-" + loop.index %}
              {% set visitorName %}{{ visitor.firstName }} {{ visitor.lastName }}{% endset %}
              {% set contactDetailsUrl = dpsContacts + '/prisoner/' + prisonerNumber
                                                     + '/contacts/manage/' + visitor.visitorId
                                                     + '/relationship/' + visitor.relationshipId %}

              {%- set unlinkVisitorHtml -%}
                <form action="/manage-bookers/{{ booker.reference }}/prisoner/{{ prisonerNumber }}/visitor/{{ visitor.visitorId }}/unlink" method="POST" novalidate>
                  <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                  {{ govukButton({
                    html: 'Unlink visitor <span class="govuk-visually-hidden">' + (visitorName | escape) + '</span>',
                    classes: "bapv-link-button",
                    preventDoubleClick: true,
                    attributes: { "data-test": visitorIndex + "-unlink" }
                  }) }}
                </form>
              {%- endset %}

              {# Forced to build unique data structure for different rows, due to rowspan #}
              {%- if loop.first %}
                {%- set prisonerRow = [
                  {
                    html: '<span class="govuk-!-font-weight-bold govuk-!-display-block" data-test="' + prisonerIndex + '-prisoner-name">' +
                    prisonerName +
                    '</span>' +
                    '<span class="govuk-!-display-block" data-test="' + prisonerIndex + '-prison-number">' +
                    prisonerNumber +
                    '</span>',
                    rowspan: prisoner.permittedVisitors | length
                  },
                  {
                    html: '<a href="'+ contactDetailsUrl +'" target="_blank" rel="noopener noreferrer" class="govuk-link--no-visited-state"><span class="govuk-visually-hidden">View contact details for</span> ' + visitorName + ' <span class="govuk-visually-hidden">(opens in a new tab)</span>
                    </a>',
                    classes: "bapv-vertical-align-middle",
                    attributes: { "data-test": visitorIndex +  "-contact-link" }
                  },
                  {
                    text : (visitor.dateOfBirth | formatDate) + " (" + (visitor.dateOfBirth | displayAge) + ")",
                    attributes: { "data-test": visitorIndex + "-dob" }
                  },
                  ({
                    html: unlinkVisitorHtml,
                    classes: "bapv-vertical-align-middle"
                  } if active)
                ] %}
              {%- else %}
                {%- set prisonerRow = [
                  {
                    html: '<a href="'+ contactDetailsUrl +'" target="_blank" rel="noopener noreferrer" class="govuk-link--no-visited-state"><span class="govuk-visually-hidden">View contact details for</span> ' + visitorName + ' <span class="govuk-visually-hidden">(opens in a new tab)</span>
                    </a>',
                    classes: "bapv-vertical-align-middle",
                    attributes: { "data-test": visitorIndex +  "-contact-link" }
                  },
                  {
                    text : (visitor.dateOfBirth | formatDate) + " (" + (visitor.dateOfBirth | displayAge) + ")",
                    attributes: { "data-test": visitorIndex + "-dob" }
                  },
                  ({
                    html: unlinkVisitorHtml,
                    classes: "bapv-vertical-align-middle"
                  } if active)
                ] %}
              {%- endif %}

              {%- set prisonerRowItems = (prisonerRowItems.push(prisonerRow), prisonerRowItems) %}
            {% endfor -%}

          {% else %}
            {%- set prisonerRow = [
              {
                html: '<span class="govuk-!-font-weight-bold govuk-!-display-block" data-test="' + prisonerIndex + '-prisoner-name">' +
                prisonerName +
                '</span>' +
                '<span class="govuk-!-display-block" data-test="' + prisonerIndex + '-prison-number">' +
                prisonerNumber +
                '</span>',
                rowspan: 1
              },
              {
                text: 'No linked visitors',
                attributes: { "data-test": prisonerIndex + "-no-linked-visitors" }
              },
              {
                text: 'No linked visitors'
              },
              ({
                html: unlinkVisitorHtml,
                classes: "bapv-vertical-align-middle"
              } if active)
            ] %}
            {% set prisonerRowItems = (prisonerRowItems.push(prisonerRow), prisonerRowItems) %}
          {% endif %}

          {% if visitorRequests[prisonerNumber] | length %}
            {# Build visitor request table row items #}
            {%- for request in visitorRequests[prisonerNumber] %}
              {% set requestIndex = prisonerIndex + "-visitor-request-" + loop.index %}
              {% set visitorName = request.firstName + " " + request.lastName %}

              {%- set visitorRequestRowItems = (visitorRequestRowItems.push([
                {
                  html: '<span class="govuk-!-font-weight-bold govuk-!-display-block" data-test="' + requestIndex + '-prisoner-name">' +
                  prisonerName +
                  '</span>' +
                  '<span class="govuk-!-display-block" data-test="' + requestIndex + '-prison-number">' +
                  prisonerNumber +
                  '</span>'
                },
                {
                  text: visitorName,
                  attributes: { "data-test": requestIndex + "-name" }
                },
                {
                  text: request.requestedOn | formatDate("d/M/yyyy"),
                  attributes: { "data-test": requestIndex + "-requested-date" }
                },
                {
                  html: '<a class="govuk-link--no-visited-state" href="/manage-bookers/visitor-request/' + request.reference + '/link-visitor?from=booker-details" >' +
                  'View<span class="govuk-visually-hidden"> request to add ' + (visitorName | escape) + ' as a visitor</span></a>',
                  classes: "govuk-!-text-align-right",
                  attributes: { "data-test": requestIndex + "-action" }
                }
              ]), visitorRequestRowItems) %}
            {% endfor -%}

          {% endif %}
        {% endfor %}

        <h2 class="govuk-heading-m">Prisoners and visitors linked to this account</h2>

        {{ govukTable({
          classes: "govuk-!-margin-top-6" + (" govuk-!-width-three-quarters" if not active),
          head: [
            {
              text: 'Prisoner name and prison number'
            },
            { html: '<span class="govuk-!-display-block">Visitor name</span> <span class="govuk-!-display-block">(opens in new tab)</span>' },
            { text: "Visitor’s date of birth" },
            { text: "Action" }
          ],
          rows: prisonerRowItems
        }) if prisonerRowItems | length }}

        <h3 class="govuk-heading-s">Requests to link visitors</h3>

        {{ govukTable({
          classes: "govuk-!-margin-top-6" + (" govuk-!-width-three-quarters" if not active),
          head: [
            { text: "Prisoner name and prison number"},
            { text: "Visitor name"},
            {
              text: "Requested on"
            },
            { text: "Action", classes: "govuk-!-text-align-right"}
          ],
          rows: visitorRequestRowItems
        }) if visitorRequestRowItems | length else noVisitorRequestsHtml | safe }}

        {# Link a visitor (if account is active) #}
        {% if active %}
          {{ govukButton({
            text: "Link a visitor",
            href: "/manage-bookers/" + booker.reference + "/prisoner/" + booker.permittedPrisoners[0].prisoner.prisonerNumber + "/link-visitor",
            classes: "govuk-!-margin-top-5 govuk-button--primary",
            attributes: { "data-test": "link-visitor" },
            preventDoubleClick: true
            }) }}
        {% endif %}


      {% else %}
        <p data-test="booker-no-prisoners">This booker has no prisoners.</p>
      {% endif %}

    </div>
  </div>
{% endblock %}
